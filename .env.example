# Port the API + web app listen on
PORT=3000
# SQLite database file (created automatically)
DATABASE_PATH=./data/cm-automations.db
# Sign-in needs a password. Set to false for email-only sign-in (short test sessions only).
REQUIRE_PASSWORDS=true
# How often the automation scheduler ticks, in seconds
SCHEDULER_INTERVAL_SECONDS=30
# Optional: enables AI-assisted idea generation in the Content Studio.
# Without it the built-in rule-based idea engine is used.
ANTHROPIC_API_KEY=

# Where people reach this system (used in links sent by text, WhatsApp and email)
PUBLIC_URL=http://localhost:3000

# Texts, WhatsApp, call forwarding and missed-call text-back (Twilio).
# Each business sets its own phone/WhatsApp number in Settings → Phone & WhatsApp.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Email sending (Resend). EMAIL_FROM must be on a domain verified with Resend.
RESEND_API_KEY=
EMAIL_FROM=

# Card payments for invoices and booking deposits (Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
