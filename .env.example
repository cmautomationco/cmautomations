# Port the API + web app listen on
PORT=3000
# SQLite database file (created automatically)
DATABASE_PATH=./data/cm-automations.db
# Sign-in needs a password. Set to false for email-only sign-in (short test sessions only).
REQUIRE_PASSWORDS=true
# How often the automation scheduler ticks, in seconds
SCHEDULER_INTERVAL_SECONDS=30
# Optional: enables AI-assisted idea generation in the Content Studio.
# Without it the built-in rule-based idea engine is used.
ANTHROPIC_API_KEY=

# Where people reach this system (used in links sent by text, WhatsApp and email).
# On a live server this must be your public https:// address – Twilio and Stripe call it.
PUBLIC_URL=http://localhost:3000

# Encrypts the Twilio, Stripe and email keys each business connects in
# Settings → Connections. Set long random text on a live server (openssl rand -hex 32)
# and keep a copy safe – if it changes, businesses have to reconnect.
APP_SECRET=

# Adds the demo businesses when the database is empty. Set to false on a live server.
SEED_DEMO=true

# ── Server-wide fallback accounts (optional) ──
# Normally each business connects its OWN accounts in Settings → Connections.
# Keys here are only used by businesses that haven't connected their own.
# Full steps: docs/GO-LIVE.md

# Texts, WhatsApp, call forwarding and missed-call text-back (Twilio).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Email sending (Resend). EMAIL_FROM must be on a domain verified with Resend.
RESEND_API_KEY=
EMAIL_FROM=

# Card payments for invoices and booking deposits (Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
