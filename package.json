{
  "name": "cm-automations",
  "version": "1.0.0",
  "description": "CM Automations – a multi-business operating system: Build Funnel, Content Studio, CRM & Task Manager, all driven by an automation engine.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch server/index.js",
    "seed": "node --disable-warning=ExperimentalWarning server/db/seed.js",
    "test": "node --disable-warning=ExperimentalWarning --test tests/*.test.js",
    "screenshots": "node --disable-warning=ExperimentalWarning scripts/screenshots.mjs"
  },
  "dependencies": {
    "express": "^5.2.1"
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": "^0.130.0"
  }
}
